# Free option: get a key at https://aistudio.google.com/apikey
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-key-here
GEMINI_MODEL=gemini-3.1-flash-lite

# Optional: use Claude instead (set LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Minimum root-cause confidence (0-1) for an investigation to be reported as SUCCESS
SUCCESS_CONFIDENCE_THRESHOLD=0.6
REPORTS_DIR=reports

# Where the agent pulls logs from. It tries the REST URL first, then falls back to the file/folder.
# {service} and {bug_id} are replaced in the URL. Response may be a JSON list, a JSON object
# wrapping a list (logs/data/items/...), or plain text.
LOG_API_URL=
LOG_FILE_PATH=
LOG_MAX_LINES=200

# --- Microservice integration ---
# If set, every /api call must send header  X-API-Key: <this value>  (health/ready stay open)
SERVICE_API_KEY=
# When an investigation finishes, the result summary is POSTed here (e.g. the Spring Boot incident backend)
CALLBACK_URL=
CALLBACK_API_KEY=
# Central incident service (Spring Boot, GET /api/incidents/{id}). When set, the agent fetches the
# bug description/service/severity/logs by bug_id, so callers may send only {"bug_id": "..."}.
# Inside Docker use http://host.docker.internal:8080 instead of localhost.
CENTRAL_API_URL=http://localhost:8080
# After an investigation: SUCCESS -> POST /api/incidents/{id}/approve, FAILED -> .../reject on the central service
CENTRAL_PUSH_STATUS=true
# Extra Gemini models tried (in order) when the main one is overloaded
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-flash-lite-latest
# Comma-separated origins allowed to call this service from a browser
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Where investigations are persisted (mount as a volume in Docker)
DATA_DIR=data
